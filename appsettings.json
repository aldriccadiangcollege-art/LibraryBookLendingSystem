{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LibraryBookLendingDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-OF-AT-LEAST-32-CHARACTERS",
    "Issuer": "LibraryBookLendingSystem",
    "Audience": "LibraryBookLendingClient",
    "ExpireMinutes": 60
  },
  "Library": {
    "LoanDays": 7,
    "MaxBooksPerMember": 3,
    "MaxRenewals": 1,
    "GracePeriodDays": 1,
    "FinePerDay": 1.00,
    "DueSoonDays": 2,
    "ExcessCopyThreshold": 3,
    "BackupFolder": "C:\\LibraryBackups"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}
